# stitchgraph configuration (copy to `stitchgraph.toml`). All keys are optional.

[entry_points]
# Extra roots the detector can't see — the trust escape hatch. Pin anything that
# is reached dynamically (reflection, plugin registries, framework magic) so live
# code is never wrongly flagged stale. Use full node ids (path::qualified.name).
include = [
  # "myapp/plugins.py::register",
]
# Glob patterns over module FILE paths for framework-loaded plugin/integration trees:
# every matching module is a load root, so its module-level wiring (schema validators,
# registered hooks, dispatch tables) is never flagged dead for lack of a static importer.
# Example: Home Assistant loads every components/<domain>/* module dynamically by name.
root_modules = [
  # "components/*",
]
include_tests = true        # treat test functions as entry points

[index]
# Globs (relative to the indexed root) skipped during reindex.
ignore = [
  # "**/migrations/**",
  # "**/_vendor/**",
]
# Derived mmapped adjacency sidecar (<db>.adjcache/) for the reachability sweeps.
# Built lazily by the first sweep after a (re)index, refused automatically when
# stale, always safe to delete. Needs numpy; without it the sweeps use their
# pure-Python paths. Disable for read-only index locations.
adjacency_cache = true

[review]
threshold = 0.80            # results below this confidence are flagged needs_review

[orient]
# Hub ranking for `orient`: transitive_fan_in (default, most-depended-on) |
# pagerank | fan_in (direct in-degree, fast).
hub_metric = "transitive_fan_in"
